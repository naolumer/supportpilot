# Copy this file to .env and add your PostgreSQL connection string and Gemini API key.
# For a local Postgres server, DATABASE_URL can use a standard postgresql:// URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-3.5-flash-lite"
